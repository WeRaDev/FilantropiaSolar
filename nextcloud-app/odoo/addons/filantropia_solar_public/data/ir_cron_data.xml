<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="ir_cron_fs_import_nc_stations" model="ir.cron">
    <field name="name">Filantropia: import NC stations to CRM</field>
    <field name="model_id" ref="crm.model_crm_lead"/>
    <field name="state">code</field>
    <field name="code">model.cron_import_all_from_nc()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active" eval="True"/>
  </record>
  <record id="ir_cron_fs_public_snapshot" model="ir.cron">
    <field name="name">Filantropia: refresh public website snapshot</field>
    <field name="model_id" ref="model_fs_public_snapshot"/>
    <field name="user_id" ref="base.user_root"/>
    <field name="state">code</field>
    <field name="code">model.cron_refresh_public_snapshot()</field>
    <field name="interval_number">15</field>
    <field name="interval_type">minutes</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
