<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_fs_dashboard_form" model="ir.ui.view">
    <field name="name">fs.dashboard.form</field>
    <field name="model">fs.dashboard</field>
    <field name="arch" type="xml">
      <form string="Filantropia NC Dashboard" create="false" edit="false" delete="false">
        <header>
          <button name="action_refresh" type="object" string="Refresh" class="btn-secondary"/>
          <button name="action_open_nextcloud" type="object" string="Open Nextcloud" class="btn-primary"/>
          <button name="action_import_nc_stations" type="object" string="Import NC stations to CRM" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>Filantropia / Nextcloud</h1>
          </div>
          <group>
            <group string="Fleet KPIs (public API)">
              <field name="station_count"/>
              <field name="planned_count"/>
              <field name="existing_count"/>
              <field name="total_capacity_kwp"/>
              <field name="total_savings_eur"/>
            </group>
            <group string="Links">
              <field name="nc_admin_url" widget="url"/>
              <field name="last_error"/>
            </group>
          </group>
          <group>
            <field name="notes" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_fs_dashboard" model="ir.actions.act_window">
    <field name="name">NC Dashboard</field>
    <field name="res_model">fs.dashboard</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>

  <menuitem id="menu_fs_root"
            name="Filantropia"
            sequence="45"
           />
  <menuitem id="menu_fs_dashboard"
            name="NC Dashboard"
            parent="menu_fs_root"
            action="action_fs_dashboard"
            sequence="10"/>
</odoo>
