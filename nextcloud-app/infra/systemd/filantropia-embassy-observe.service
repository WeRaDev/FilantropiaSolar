[Unit]
Description=Observe Odoo origin and standby recovery readiness for FilantropiaSolar
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathIsMountPoint=/data
ConditionPathExists=/data/filantropia-embassy
ConditionPathExists=/etc/filantropia-embassy/embassy.toml
ConditionPathExists=/etc/filantropia-embassy/readiness.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=10min
EnvironmentFile=/etc/filantropia-embassy/readiness.env
Environment=PYTHONPATH=/usr/local/lib/filantropia-embassy
ExecStart=/usr/bin/python3 -m embassy.service
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/data/filantropia-embassy

