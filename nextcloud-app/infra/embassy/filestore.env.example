# Install as /etc/filantropia-embassy/filestore.env with root:root, mode 0600.
FS_FILESTORE_REMOTE_USER=filestore-replica
FS_FILESTORE_REMOTE_HOST=REPLACE_WITH_TRL5_TAILNET_HOST
FS_FILESTORE_REMOTE_PATH=/var/lib/docker/volumes/nextcloud-app_odoo_data/_data/filestore/filantropia_public
FS_FILESTORE_LOCAL_PATH=/data/filantropia-embassy/filestore/filantropia_public
FS_FILESTORE_SSH_KEY=/etc/filantropia-embassy/filestore-readonly
FS_FILESTORE_KNOWN_HOSTS=/etc/filantropia-embassy/known_hosts
FS_FILESTORE_STATUS_PATH=/data/filantropia-embassy/filestore-status.json
FS_FILESTORE_SOURCE_NODE_ID=trl5
FS_FILESTORE_SOURCE_GENERATION=REPLACE_WITH_CURRENT_WRITER_GENERATION
