# Install as /etc/filantropia-embassy/lease.env with root:root, mode 0600.
# Do not enable production takeover until isolated rehearsal succeeds.

FS_EMBASSY_NODE_ID=trl5
FS_WRITER_GENERATION=REPLACE_WITH_CURRENT_WRITER_GENERATION
FS_LEASE_AUTHORITY_URL=https://filantropia-odoo-writer-gate.example.workers.dev
FS_LEASE_AUTHORITY_TOKEN=REPLACE_WITH_LEASE_API_TOKEN
FS_LEASE_TIMEOUT_SECONDS=5
FILANTROPIA_LEASE_GUARD_STATE=/etc/filantropia-embassy/lease-guard-state.json
FILANTROPIA_ODOO_FENCE_FILE=/etc/filantropia-embassy/odoo-fenced.json
