# Install as /etc/filantropia-embassy/readiness.env with root:root, mode 0600.
# Use one stable node ID and a new writer generation for each ownership epoch.
# Install the same readiness token, node ID, and generation in Odoo and on the
# TRL5 systemd stack/backup services. The generation is an identifier, not a secret.
FS_EMBASSY_READINESS_TOKEN=REPLACE_WITH_SECRET_FROM_SECRET_MANAGER
FS_EMBASSY_NODE_ID=trl5
FS_WRITER_GENERATION=REPLACE_WITH_CURRENT_WRITER_GENERATION
FS_ADDON_SOURCE_DIRECTORY=/opt/FilantropiaSolar/nextcloud-app/odoo/addons/filantropia_solar_public
