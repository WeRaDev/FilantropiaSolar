{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {"uri": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "policy_lock": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_version", "upstream_commit", "files"],
      "properties": {
        "bundle_version": {"$ref": "#/$defs/text"},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "project_id", "purpose", "owners", "profile", "admission", "runtime", "constraints"],
      "properties": {
        "schema_version": {"const": 1}, "project_id": {"$ref": "#/$defs/text"},
        "purpose": {"$ref": "#/$defs/text"},
        "profile": {"enum": ["dev-sandbox", "runtime-observer", "business-action", "critical-action"]},
        "admission": {"enum": ["pending", "approved", "suspended"]},
        "constraints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "owners": {
          "type": "object", "additionalProperties": false,
          "required": ["business", "technical", "review_status"],
          "properties": {
            "business": {"type": ["string", "null"]}, "technical": {"type": ["string", "null"]},
            "review_status": {"enum": ["pending", "approved"]}
          }
        },
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "rationale", "agents"],
          "properties": {
            "status": {"enum": ["unassessed", "none", "present"]},
            "rationale": {"type": "string"},
            "agents": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["id", "purpose", "deployment", "profile", "status"],
                "properties": {
                  "id": {"$ref": "#/$defs/text"}, "purpose": {"$ref": "#/$defs/text"},
                  "deployment": {"$ref": "#/$defs/text"}, "profile": {"$ref": "#/$defs/text"},
                  "status": {"enum": ["discovered-unverified", "approved", "retired", "quarantined"]}
                }
              }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "project_id", "upstream_commit", "controls"],
      "properties": {
        "schema_version": {"const": 1}, "project_id": {"$ref": "#/$defs/text"},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "controls": {
          "type": "array", "minItems": 35, "maxItems": 35,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "applicability", "state", "reason", "reviewer", "verified_at", "enforcement", "evidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^(DIS|CON|AUT|OBS|VAL|RES)-[0-9]{2}$"},
              "applicability": {"enum": ["applicable", "not-applicable"]},
              "state": {"enum": ["unassessed", "gap", "designed", "implemented-unverified", "verified", "exception-approved"]},
              "reason": {"$ref": "#/$defs/text"}, "reviewer": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
              "verified_at": {"type": ["string", "null"], "format": "date-time"}, "enforcement": {"type": "array", "items": {"$ref": "#/$defs/text"}},
              "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
              "exception_id": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    },
    "components": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "scope", "components"],
      "properties": {
        "schema_version": {"const": 1},
        "scope": {"const": "declared-local-composition-only"},
        "components": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "path", "sha256", "source", "review_status"],
            "properties": {
              "id": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"},
              "sha256": {"$ref": "#/$defs/sha256"}, "source": {"const": "local-working-tree"},
              "review_status": {"enum": ["pending", "approved", "quarantined"]}
            }
          }
        }
      }
    },
    "exceptions": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "exceptions"],
      "properties": {
        "schema_version": {"const": 1},
        "exceptions": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "controls", "owner", "requester", "approver", "reason", "compensating_controls", "expires_at", "exit_task"],
            "properties": {
              "id": {"$ref": "#/$defs/text"},
              "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
              "owner": {"$ref": "#/$defs/text"}, "requester": {"$ref": "#/$defs/text"},
              "approver": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"},
              "compensating_controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
              "expires_at": {"type": "string", "format": "date-time"}, "exit_task": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    }
  }
}
