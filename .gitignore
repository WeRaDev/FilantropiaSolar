# ==========================================
# FilantropiaSolar Specific
# ==========================================

# Data files (large datasets)
data/
!data/
!data/**
!data/.gitkeep
!data/README.md
weather_files/
!weather_files/
!weather_files/**
!weather_files/.gitkeep
!weather_files/README.md

# Model files (trained ML models)
models/
!models/.gitkeep
!models/README.md

# Log files
logs/
*.log
!logs/.gitkeep

# Export files
exports/
!exports/.gitkeep
!exports/README.md

# Configuration files with sensitive data
config/local.py
config/production.py
secrets.yaml
secrets.json

# Cache directories
.cache/
cache/

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup
*~

# Archive directory (development artifacts)
archive/
old/
backup/

