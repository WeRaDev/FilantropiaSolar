# ==========================================
# Custom ignore patterns
# ==========================================
# Add your custom patterns here

# Large files that shouldn't be committed
*.csv
*.xlsx
*.xls
# Allow critical runtime data assets
!average_values.csv
!data/**/*.csv
!weather_files/**/*.csv
!data/sample_*.csv
!tests/fixtures/*.csv

# Generated files
generated/
auto_generated/
*.generated.*