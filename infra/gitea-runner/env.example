# Registration token for the wera-global org runner.
# Obtain via Gitea API (POST, admin credentials required):
#   curl -u <user> -X POST http://127.0.0.1:3000/api/v1/orgs/wera-global/actions/runners/registration-token
# Only needed on first start; afterwards the runner reuses /data/.runner in the volume.
GITEA_RUNNER_REGISTRATION_TOKEN=
